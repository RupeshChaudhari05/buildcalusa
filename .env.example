# =====================================================================
# BuildCalcUSA settings
# Copy to .env and fill in. .env is never committed (see .gitignore)
# and is blocked from the web by .htaccess.
# Empty value = use the default shown. Booleans: true / false.
# =====================================================================

# ---- Environment -----------------------------------------------------
# Leave empty: localhost = development, any other host = production.
# Set to "production" to test production locally, or "development" to debug live.
APP_ENV=

# Canonical site address used in production for links, canonicals and the sitemap.
# Must be https and WITHOUT www (.htaccess 301-redirects www -> bare domain).
BASE_URL=https://buildcalcusa.com

# Timezone used for tool publish dates
TIMEZONE=America/New_York

# ---- Brand & contact -------------------------------------------------
SITE_NAME=BuildCalcUSA
SITE_TAGLINE=Free Contractor & DIY Construction Calculators
SITE_DOMAIN=buildcalcusa.com
# Shown on Contact, Privacy and in Organization schema
CONTACT_EMAIL=classstatus0@gmail.com

# Year the default prices were researched for (appears in titles). Bump only after re-checking prices.
PRICE_YEAR=2026

# ---- E-E-A-T: real people only ----------------------------------------
AUTHOR_NAME=BuildCalcUSA Editorial Team
AUTHOR_ROLE=Construction estimators & contractors
REVIEWER_NAME=
REVIEWER_ROLE=

# ---- Search engines ----------------------------------------------------
# Only the content="..." value of the verification meta tag
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Google Analytics 4 -------------------------------------------------
# Measurement ID, e.g. G-ABC123XYZ (empty = analytics off)
GA_ID=
# load = start after page load (recommended: counts nearly every visit, no Core Web Vitals cost)
# interaction = start on first scroll/tap (fastest, misses quick bounces)
GA_LOAD=load
# Consent Mode v2: deny storage by default in EEA/UK/CH until the visitor accepts (required by Google)
CONSENT_MODE=true

# ---- Google AdSense ---------------------------------------------------
# Publisher id, e.g. ca-pub-1234567890123456 (empty = no ads, ads.txt shows a placeholder)
ADSENSE_CLIENT=
AD_SLOT_AFTER_CALC=
AD_SLOT_AFTER_CONTENT=
# true = outline empty ad positions on localhost to check layout (never shown on the live site)
SHOW_AD_PLACEHOLDERS=false
# Extra ads.txt lines for other networks, separated by |
# e.g. ADS_TXT_EXTRA=ezoic.ai, 12345, DIRECT|example.com, abc, RESELLER
ADS_TXT_EXTRA=

# ---- Affiliates -------------------------------------------------------
# Tracking prefix; the retailer URL is url-encoded and appended (Impact links end in ?u=)
AFF_HOMEDEPOT=
AFF_LOWES=
AMAZON_TAG=

# ---- Lead gen: "Get free local quotes" button (empty = hidden) ---------
QUOTE_LINK_FENCE=
QUOTE_LINK_DECK=
QUOTE_LINK_ROOFING=
QUOTE_LINK_SIDING=
QUOTE_LINK_CONCRETE=
QUOTE_LINK_PAVING=
QUOTE_LINK_LANDSCAPING=
QUOTE_LINK_DRYWALL=
QUOTE_LINK_PAINTING=
QUOTE_LINK_INSULATION=
QUOTE_LINK_FLOORING=
QUOTE_LINK_REMODEL=
QUOTE_LINK_DUMPSTER=
QUOTE_LINK_JUNK=

# ---- Publishing & cache ------------------------------------------------
# true = show every tool regardless of publish date (localhost defaults to true; never on live)
SHOW_UNPUBLISHED=
# Full-page cache in minutes (production only; 0 = off)
PAGE_CACHE_MINUTES=60
