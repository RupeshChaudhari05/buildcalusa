# ----------------------------------------------------------------------
# BuildCalcUSA – Apache config (CodeIgniter 3)
# ----------------------------------------------------------------------
Options -Indexes
ServerSignature Off
AddDefaultCharset utf-8
DirectoryIndex index.php

# localhost = development, everything else = production (APP_ENV in .env can override)
SetEnvIf Host "^(localhost|127\.0\.0\.1)" CI_ENV=development
SetEnvIf Host ".+" LIVE_HOST=1
SetEnvIf Host "^(localhost|127\.0\.0\.1)" !LIVE_HOST

<IfModule mod_rewrite.c>
    RewriteEngine On

    # BASE = URL folder this .htaccess lives in ("/" on the live site, "/contractor_cal/" on localhost).
    # Rewrites below use it as an absolute path. Hosts like DreamHost map the domain to a server
    # path (/home/user/domain/); a relative target resolves against that path and PHP then fails
    # with "No input file specified".
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=BASE:%1]
    # If it can't be worked out (unusual host path mapping), the site is at the domain root
    RewriteCond %{ENV:BASE} ^$
    RewriteRule ^ - [E=BASE:/]

    # Canonical origin = https + non-www (industry standard: one version, one 301 hop).
    # Works for any domain; localhost is never redirected. BASE_URL in .env must match (no www).
    # www (http or https) -> https://bare-domain in a single hop
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]
    # http -> https. X-Forwarded-Proto stops redirect loops behind Cloudflare or a load balancer.
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

    # Block dotfiles (.env, .git, .gitignore…) but keep .well-known for SSL/ownership checks
    RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

    # Remove trailing slashes (one canonical URL per page), straight to https on live hosts
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ https://%{HTTP_HOST}%1 [L,R=301,NE]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Never serve framework / source files. Matched on REQUEST_URI so it works in any folder.
    RewriteCond %{REQUEST_URI} /(application|system|vendor|tests|node_modules|docs)(/|$) [NC,OR]
    RewriteCond %{REQUEST_URI} /(composer\.(json|lock)|package(-lock)?\.json|build\.js|build-images\.php|build-seo-doc\.php|build-release\.sh|readme\.rst|license\.txt|DCO\.txt)$ [NC,OR]
    RewriteCond %{REQUEST_URI} \.md$ [NC]
    RewriteRule ^ - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Front controller, WordPress-style: absolute "/index.php" with nothing appended (the form that
    # works on DreamHost and other PHP-FPM/FastCGI hosts). CodeIgniter reads the page from
    # REQUEST_URI (uri_protocol), and the query string is kept automatically.
    RewriteRule ^ %{ENV:BASE}index.php [L]
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/xml application/rss+xml application/javascript application/x-javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>

# ---------- Browser caching ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    # Assets are versioned with ?v=mtime, so they can be immutable
    <FilesMatch "\.(css|js|svg|png|webp|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Version marker: lets us confirm which .htaccess is live (curl -I https://buildcalcusa.com/)
    Header always set X-BC-Config "htaccess-2026-10-22-v3"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # HSTS on live hosts only (browsers then always use https; never on localhost)
    Header always set Strict-Transport-Security "max-age=31536000" env=LIVE_HOST
</IfModule>

AddType application/manifest+json .webmanifest
